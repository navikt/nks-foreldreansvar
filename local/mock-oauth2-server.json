{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "azuread",
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "saas-proxy-local",
          "claims": {
            "sub": "saas-proxy-local",
            "aud": ["nks-foreldreansvar-local"],
            "azp": "saas-proxy-local",
            "idtyp": "app",
            "roles": ["access_as_application"]
          }
        }
      ]
    }
  ]
}
